# Copy this file to .env and fill in the values. Never commit .env.

# TMDB API Read Access Token (TMDB account > Settings > API).
# Temporary: Vite embeds every VITE_* variable in the browser bundle, so this
# token is visible to anyone using the built site. It moves to a server-only
# variable once the backend API proxy is in place.
VITE_APP_TMDB_TOKEN=
